# backend/.env.production.example
# Copy this file to .env on the EC2 instance and fill in real values.
# NEVER commit .env to version control.

# ── Django core ────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=REPLACE_WITH_50_CHAR_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP,YOUR_EC2_HOSTNAME,api.yourdomain.com

# ── CORS / CSRF ────────────────────────────────────────────────────────────────
# Set this to your deployed Vercel frontend URL after deployment.
FRONTEND_ORIGIN=https://YOUR_PROJECT.vercel.app

# ── Gemini API ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
